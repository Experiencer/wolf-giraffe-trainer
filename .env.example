# Diese Werte trägst du in Vercel unter Project → Settings → Environment Variables ein.
# Lokal (vercel dev) kannst du eine Datei .env.local mit denselben Zeilen anlegen. Niemals ins Git hochladen!

# Pflicht für den Claude-Coach und das Text-Rollenspiel
ANTHROPIC_API_KEY=sk-ant-...

# Pflicht für das Echtzeit-Gespräch und die natürliche Stimme (Coach + Gegenüber)
OPENAI_API_KEY=sk-...

# Empfohlen: schützt deine Schlüssel vor fremder Nutzung. Wer die App öffnet, muss diesen Code einmal eingeben.
APP_ACCESS_CODE=ein-langes-geheimes-wort

# Optional – nur ändern, wenn sich Modellnamen ändern
# COACH_MODEL=claude-sonnet-5-5
# COACH_MODEL_QUICK=claude-haiku-4-5-20251001
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
# TTS_MODEL=gpt-4o-mini-tts
